{
  "version": 3,

  "settings": {

    "appearanceTools": true,

    "custom": {

      "headerHeight": "82px",
      "glassBlur": "18px"

    },

    "layout": {

      "contentSize": "80vw",
      "wideSize": "90vw"

    },

    "spacing": {

      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ]

    },

    "typography": {

      "fontFamilies": [

        {
          "slug": "system",
          "name": "System UI",
          "fontFamily": "-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif"
        }

      ]

    },

    "color": {

     "palette": [

        {
          "slug": "primary",
          "name": "HYLA Orange",
          "color": "#F47A1F"
        },

        {
          "slug": "primary-dark",
          "name": "Deep Orange",
          "color": "#D85E07"
        },

        {
          "slug": "black",
          "name": "Premium Black",
          "color": "#0B0B0C"
        },

        {
          "slug": "charcoal",
          "name": "Charcoal",
          "color": "#161616"
        },

        {
          "slug": "light",
          "name": "Soft White",
          "color": "#FFFFFF"
        },

        {
          "slug": "cream",
          "name": "Warm White",
          "color": "#F7F5F2"
        }

      ]

    }

  },

  "styles": {

    "color": {

      "background": "#FFFFFF",
      "text": "#07111F"

    },

    "typography": {

      "fontFamily": "var(--wp--preset--font-family--system)",
      "lineHeight": "1.5"

    },

    "blocks": {

      "core/group": {

        "spacing": {

          "padding": {

            "top": "1rem",
            "bottom": "1rem",
            "left": "1.5rem",
            "right": "1.5rem"

          }

        }

      },

      "core/site-logo": {

        "spacing": {

          "margin": {

            "right": "1rem"

          }

        }

      },

      "core/navigation": {

        "typography": {

          "fontSize": "14px",
          "fontWeight": "500",
          "letterSpacing": "0.02em"

        },

        "spacing": {

          "blockGap": "1.75rem"

        },

        "color": {

          "text": "#07111F"

        }

      },

      "core/navigation-link": {

        "typography": {

          "fontSize": "14px",
          "fontWeight": "500"

        },

        "color": {

          "text": "#07111F"

        }

      },

      "core/button": {

        "border": {

          "radius": "999px"

        },

        "typography": {

          "fontSize": "13px",
          "fontWeight": "600",
          "letterSpacing": "0.03em",
          "textTransform": "uppercase"

        },

        "spacing": {

          "padding": {

            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.35rem",
            "right": "1.35rem"

          }

        },

        "color": {

          "background": "#F47A1F",
          "text": "#FFFFFF"

        },

        "shadow": "0 10px 30px rgba(10,75,143,0.15)"

      }

    }

  }
}