{
  "version": 3,
  "settings": {
    "appearanceTools": true,

    "layout": {
      "contentSize": "80vw",
      "wideSize": "90vw"
    },

    "custom": {
      "headerHeight": "86px",
      "headerHeightScrolled": "58px",
      "glassBlur": "22px",
      "transition": ".35s cubic-bezier(.22,.61,.36,1)",
      "radiusSmall": "16px",
      "radiusMedium": "24px",
      "radiusLarge": "32px",
      "radiusPill": "999px"
    },

    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        {
          "slug": "xs",
          "size": "0.5rem",
          "name": "XS"
        },
        {
          "slug": "sm",
          "size": "1rem",
          "name": "Small"
        },
        {
          "slug": "md",
          "size": "1.5rem",
          "name": "Medium"
        },
        {
          "slug": "lg",
          "size": "2rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "4rem",
          "name": "XL"
        }
      ]
    },

    "typography": {
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System UI",
          "fontFamily": "-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif"
        }
      ]
    },

    "color": {
        "typography": {
          "fontSize": "14px",
          "fontWeight": "600",
          "letterSpacing": "0.015em"
        },
        "spacing": {
          "blockGap": "2rem"
        },
        "color": {
          "text": "var(--wp--preset--color--text)"
        }
      },

      "core/navigation-link": {
        "typography": {
          "fontSize": "14px",
          "fontWeight": "600"
        },
        "color": {
          "text": "var(--wp--preset--color--text)"
        }
      },

      "core/button": {
        "border": {
          "radius": "999px"
        },

        "typography": {
          "fontSize": "13px",
          "fontWeight": "700",
          "letterSpacing": "0.03em",
          "textTransform": "uppercase"
        },

        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.35rem",
            "right": "1.35rem"
          }
        },

        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--light)"
        }
      }
    }
  }
