{
  "version": 3,

  "settings": {

    "appearanceTools": true,

    "layout": {
      "contentSize": "1280px",
      "wideSize": "1440px"
    },

    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"]
    },

    "typography": {

      "fontFamilies": [
        {
          "slug": "system",
          "name": "System UI",
          "fontFamily": "-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif"
        }
      ]

    },

    "color": {

      "palette": [

        {
          "slug": "primary",
          "name": "HYLA Blue",
          "color": "#0A4B8F"
        },

        {
          "slug": "navy",
          "name": "Deep Navy",
          "color": "#07111F"
        },

        {
          "slug": "light",
          "name": "Soft White",
          "color": "#FFFFFF"
        }

      ]

    }

  },

  "styles": {

    "color": {
      "background": "#FFFFFF",
      "text": "#07111F"
    },

    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "lineHeight": "1.5"
    },

    "blocks": {

      "core/group": {

        "spacing": {

          "padding": {
            "top": "1rem",
            "bottom": "1rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }

        }

      },

      "core/site-logo": {

        "spacing": {

          "margin": {
            "right": "1rem"
          }

        }

      },

      "core/navigation": {

        "typography": {

          "fontSize": "14px",
          "fontWeight": "500",
          "letterSpacing": "0.02em"

        },

        "spacing": {

          "blockGap": "1.75rem"

        },

        "color": {

          "text": "#07111F"

        }

      },

      "core/navigation-link": {

        "typography": {

          "fontSize": "14px",
          "fontWeight": "500"

        },

        "color": {

          "text": "#07111F"

        }

      },

      "core/button": {

        "border": {

          "radius": "999px"

        },

        "typography": {

          "fontSize": "13px",
          "fontWeight": "600",
          "letterSpacing": "0.03em",
          "textTransform": "uppercase"

        },

        "spacing": {

          "padding": {

            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.35rem",
            "right": "1.35rem"

          }

        },

        "color": {

          "background": "#0A4B8F",
          "text": "#FFFFFF"

        },

        "shadow": "0 10px 30px rgba(10,75,143,0.15)"

      }

    }

  }
}